table dim_date
	lineageTag: e744c82b-fa64-44a4-aa10-5e7fbcc52234
	sourceLineageTag: [GOLD_LAYER].[dim_date]
	dataCategory: Time

	measure 'Sales LM' = CALCULATE([Total Sales], DATEADD('dim_date'[calendar_date], -1, MONTH))
		lineageTag: 7a552a40-5cd8-43f1-b95b-20aa22946f8d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales MoM %' = DIVIDE([Total Sales] - [Sales LM], [Sales LM], 0)
		lineageTag: f03d8c35-93cc-4f2c-b5f6-215a6c7809ff

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}


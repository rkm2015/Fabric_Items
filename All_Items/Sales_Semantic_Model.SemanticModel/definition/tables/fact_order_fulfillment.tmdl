table fact_order_fulfillment
	lineageTag: efe15d73-252e-447c-aafa-b81d978de31e
	sourceLineageTag: [GOLD_LAYER].[fact_order_fulfillment]

	measure 'Avg Days to Ship' = AVERAGE(fact_order_fulfillment[days_to_ship])
		lineageTag: 5a0327d0-6c77-4188-b4d5-9c978ab12ea3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Fulfillment Rate' =
			
			DIVIDE(
			    CALCULATE(COUNT(fact_order_fulfillment[order_id]), fact_order_fulfillment[is_completed] = TRUE),
			    COUNT(fact_order_fulfillment[order_id]),
			    0
			)
		lineageTag: cd0d1e2c-31dd-46b0-8cf1-6fe6b0ffab8e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

